    {
      "id": "chibi-head",
      "baseType": "part_views",
      "badge": "Q版Mod",
      "title": "🎀 Q版盲盒大头拆件（防断发加固）",
      "description": "自带 2.5 头身萌系脸颊比例锁死与呆毛加厚规则",
      "params": {
        "partName": "Q版头部（含加厚头发）",
        "promptHint": "保持Q版圆润包脸轮廓，呆毛与发尾聚拢加厚，彻底去除脖子与衣领",
        "pose": "natural",
        "resolution": 2048
      },
      "craftRules": [
        "Q版潮玩头部铁律：五官集中于面中偏下位置，双耳圆润外露；所有呆毛、双马尾与飘带厚度不得低于 8px，严禁细如发丝的碎刺以防 3D 网格断裂。"
      ]
    },
    {
      "id": "chibi-body",
      "baseType": "part_views",
      "badge": "Q版Mod",
      "title": "🧸 Q版圆润身体（含圆柱插栓脖颈）",
      "description": "短萌四肢 T-Pose + 粗壮颈部插接柱 + 平底可站立鞋底",
      "params": {
        "partName": "Q版身体（带颈部插栓）",
        "promptHint": "去头去道具，短萌双臂水平90°展开，顶部留粗圆柱脖子插栓，鞋底水平对齐",
        "pose": "t",
        "resolution": 2048
      },
      "craftRules": [
        "Q版潮玩躯干铁律：头身比对应的躯干紧凑圆润，腋下与双腿内侧必须留出清晰透明空隙避免短肢粘连；鞋底保持同一水平面以便桌面平稳站立。"
      ]
    }
  ],

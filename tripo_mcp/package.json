{
  "name": "morphogem-tripo-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "High-level MCP server and persistent CLI controller for Tripo Studio (reusing logged-in desktop Chrome via CDP, with optional Open API v3 support)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tripo-mcp": "./server.mjs",
    "tripo-cli": "./cli.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "daemon": "node daemon.mjs",
    "cli": "node cli.mjs",
    "test": "node test-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "puppeteer-core": "^24.0.0",
    "zod": "^3.24.0"
  }
}
